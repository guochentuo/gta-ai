[Unit]
Description=GTA AudioSet AST CPU Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gta-ai/ast-audioset
Environment="GTA_AI_CONFIG_FILES=/opt/gta-ai/ast-audioset/config/audio-events.env,/opt/gta-ai/ast-audioset/config/node.env"
ExecStartPre=-/usr/bin/podman rm --force gta-ai-audio-events
ExecStart=/opt/gta-ai/ast-audioset/deploy/run-audio-events
ExecStop=-/usr/bin/podman stop --time 30 gta-ai-audio-events
Restart=on-failure
RestartSec=15
TimeoutStartSec=1800
TimeoutStopSec=60
CPUQuota=800%
CPUWeight=20
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=0
IOWeight=20
Nice=10
OOMScoreAdjust=500
TasksMax=1024
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gta-ai-audio-events

[Install]
WantedBy=multi-user.target
