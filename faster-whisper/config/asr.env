ASR_HOST=192.168.80.2
ASR_PORT=7104
ASR_MODEL=Systran/faster-whisper-large-v3
ASR_MODEL_CACHE=/opt/gta-ai/faster-whisper/data/cache
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=5
ASR_CHUNK_LENGTH_SEC=30
ASR_CONDITION_ON_PREVIOUS_TEXT=false
ASR_VERIFY_ENABLED=true
ASR_VERIFY_CHUNK_LENGTH_SEC=25
ASR_VERIFY_MIN_TEXT_AGREEMENT=0.72
ASR_VERIFY_MAX_END_DIFFERENCE_SEC=15
ASR_MAX_AUDIO_BYTES=268435456
ASR_SPEECH_GATE_MINIMUM_SEC=0.8
ASR_GPU_ADMISSION_ENABLED=false
