[Unit]
Description=GTA faster-whisper ASR Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/opt/gta-ai/asr/config/asr.env
ExecStart=/usr/bin/python3 /opt/gta-ai/bin/json-log-runner.py --service gta-ai --module ASR --log-file /opt/gta-ai/logs/gta.ai.asr.jsonl --max-size-mb 20 --backups 10 -- /opt/gta-ai/asr/venv/bin/python /opt/gta-ai/asr/app.py --host ${ASR_HOST} --port ${ASR_PORT}
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=30
CPUQuota=12800%
MemoryHigh=12G
MemoryMax=16G
MemorySwapMax=0
Nice=5
TasksMax=1024
LimitNOFILE=65536
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
