ASR_HOST=192.168.80.7
ASR_PORT=18084
ASR_MODEL=Systran/faster-whisper-large-v3
ASR_MODEL_CACHE=/opt/gta-ai/asr/data/models
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=int8_float16
LD_LIBRARY_PATH=/opt/gta-ai/asr/venv/lib/python3.12/site-packages/nvidia/cublas/lib:/opt/gta-ai/asr/venv/lib/python3.12/site-packages/nvidia/cudnn/lib
ASR_BEAM_SIZE=5
ASR_CPU_THREADS=32
ASR_NUM_WORKERS=1
ASR_MAX_CONCURRENT=1
ASR_CHUNK_LENGTH_SEC=30
ASR_CONDITION_ON_PREVIOUS_TEXT=false
ASR_VERIFY_ENABLED=true
ASR_VERIFY_CHUNK_LENGTH_SEC=25
ASR_VERIFY_MIN_TEXT_AGREEMENT=0.72
ASR_VERIFY_MIN_SPEECH_DURATION_AGREEMENT=0.85
ASR_VERIFY_MAX_END_DIFFERENCE_SEC=15
ASR_MAX_AUDIO_BYTES=268435456
ASR_SPEECH_GATE_MINIMUM_SEC=0.8
ASR_GPU_ADMISSION_ENABLED=true
ASR_GPU_ADMISSION_ENDPOINT=http://192.168.80.7:8000/_gta/admission
# Whisper模型常驻显存已计入nvidia-smi；租约仅预留推理增量工作集。
# router仍额外保留1.5GiB minimum_free安全余量。
ASR_GPU_ADMISSION_MEMORY_MB=2048
ASR_GPU_ADMISSION_WAIT_SECONDS=1800
# 心跳每30秒续租；进程异常退出后最多90秒自动释放，避免陈旧租约卡死P1。
ASR_GPU_ADMISSION_TTL_SECONDS=90
