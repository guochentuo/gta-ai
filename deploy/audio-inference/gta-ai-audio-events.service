[Unit]
Description=GTA AudioSet CPU Environment Sound Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/podman rm --force gta-ai-audio-events
ExecStart=/opt/gta-ai/ast/bin/run-audio-events
ExecStop=-/usr/bin/podman stop --time 30 gta-ai-audio-events
Restart=on-failure
RestartSec=15
TimeoutStartSec=1800
TimeoutStopSec=60

CPUQuota=800%
CPUWeight=20
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=0
IOWeight=20
Nice=10
OOMScoreAdjust=500
TasksMax=1024
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
