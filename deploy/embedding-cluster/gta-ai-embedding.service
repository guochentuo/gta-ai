[Unit]
Description=GTA Qwen3 CPU Embedding Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/podman rm --force gta-ai-embedding
ExecStart=/opt/gta-ai/embedding/bin/run-embedding
ExecStop=-/usr/bin/podman stop --time 30 gta-ai-embedding
Restart=on-failure
RestartSec=15
TimeoutStartSec=1800
TimeoutStopSec=60

# 避免 Embedding 批处理抢占 TiDB、Elasticsearch 和 Ceph 的资源。
CPUQuota=800%
CPUWeight=20
MemoryHigh=12G
MemoryMax=16G
MemorySwapMax=0
IOWeight=20
Nice=10
OOMScoreAdjust=500
TasksMax=1024
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
