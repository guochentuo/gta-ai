[Unit]
Description=GTA Dev faster-whisper ASR CPU Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/gta-ai/asr
EnvironmentFile=/opt/gta-ai/asr/config/asr.dev.env
ExecStart=/usr/bin/python3 /opt/gta-ai/bin/json-log-runner.py --service gta-ai --module ASR --log-file /opt/gta-ai/logs/gta.ai.asr.dev.jsonl --max-size-mb 20 --backups 10 -- /opt/gta-ai/asr/venv/bin/python /opt/gta-ai/asr/app.py --host ${ASR_HOST} --port ${ASR_PORT}
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=30
CPUQuota=3200%
MemoryHigh=24G
MemoryMax=32G
MemorySwapMax=0
Nice=5
TasksMax=1024
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gta-ai-asr-dev

[Install]
WantedBy=multi-user.target
