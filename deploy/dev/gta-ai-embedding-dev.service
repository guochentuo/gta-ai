[Unit]
Description=GTA Dev Qwen3 0.6B CPU Embedding Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gta-ai/embedding
Environment="GTA_AI_CONFIG_FILES=/opt/gta-ai/embedding/config/embedding.dev.env"
ExecStartPre=-/usr/bin/podman rm --force gta-ai-embedding
ExecStart=/usr/bin/python3 /opt/gta-ai/bin/json-log-runner.py --service gta-ai --module QwenEmbedding --log-file /opt/gta-ai/logs/gta.ai.embedding.dev.jsonl --max-size-mb 20 --backups 10 -- /opt/gta-ai/bin/run-embedding
ExecStop=-/usr/bin/podman stop --time 30 gta-ai-embedding
Restart=on-failure
RestartSec=15
TimeoutStartSec=1800
TimeoutStopSec=60
CPUQuota=3200%
CPUWeight=20
MemoryHigh=12G
MemoryMax=16G
MemorySwapMax=0
IOWeight=20
Nice=10
OOMScoreAdjust=500
TasksMax=1024
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gta-ai-embedding-dev

[Install]
WantedBy=multi-user.target
