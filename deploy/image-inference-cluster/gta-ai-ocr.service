[Unit]
Description=GTA PaddleOCR CPU Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/podman rm --force gta-ai-ocr
ExecStart=/opt/gta-ai-ocr/bin/run-ocr
ExecStop=-/usr/bin/podman stop --time 30 gta-ai-ocr
Restart=on-failure
RestartSec=15
TimeoutStartSec=1800
TimeoutStopSec=60

CPUQuota=800%
CPUWeight=20
MemoryHigh=12G
MemoryMax=16G
MemorySwapMax=0
IOWeight=20
Nice=10
OOMScoreAdjust=500
TasksMax=2048
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

