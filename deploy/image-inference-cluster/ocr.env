# OCR公共配置，不包含密钥。
OCR_IMAGE=localhost/gta-ai-ocr:1.1.0
OCR_PORT=18081
OCR_DATA_DIR=/opt/gta-ai-ocr/data
OCR_DETECTION_MODEL=PP-OCRv6_medium_det
OCR_RECOGNITION_MODEL=PP-OCRv6_medium_rec
OCR_MEMORY_LIMIT=16g
OCR_MAX_IMAGE_BYTES=26214400
OCR_MAX_IMAGE_PIXELS=50000000
OCR_MIN_SCORE=0.0
OCR_MAX_BATCH_SIZE=32
