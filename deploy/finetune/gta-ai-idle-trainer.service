[Unit]
Description=gta-ai preemptible idle LoRA trainer
Wants=network-online.target gta-ai-router.service
After=network-online.target gta-ai-router.service

[Service]
Type=simple
UMask=0002
EnvironmentFile=/opt/gta-ai/config/trainer.env
ExecStart=/opt/gta-ai/app/.venv/bin/gta-ai-idle-trainer
Restart=always
RestartSec=2
TimeoutStopSec=60
StandardOutput=append:/opt/gta-ai/logs/gta.ai.trainer.log
StandardError=append:/opt/gta-ai/logs/gta.ai.trainer.log

[Install]
WantedBy=default.target
