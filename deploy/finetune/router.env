# 对外保持原来的 8000；vLLM 后端移到只供路由访问的 18086。
GTA_AI_ROUTER_HOST=192.168.80.7
GTA_AI_ROUTER_PORT=8000
GTA_AI_ROUTER_BACKEND_URL=http://127.0.0.1:18086
GTA_AI_ROUTER_STATE_PATH=/opt/gta-ai/router/state/router-state.json
GTA_AI_ROUTER_GPU_LOCK_PATH=/opt/gta-ai/router/state/gpu.lock
GTA_AI_ROUTER_WAKE_TIMEOUT_SECONDS=300
GTA_AI_ROUTER_BACKEND_POLL_SECONDS=0.25
GTA_AI_ROUTER_REQUEST_TIMEOUT_SECONDS=1800
GTA_AI_ROUTER_MAX_CONCURRENT_WORKLOADS=2
GTA_AI_ADMISSION_DB_PATH=/opt/gta-ai/router/state/gpu-admission.sqlite3
GTA_AI_ADMISSION_POLL_SECONDS=0.1
# .7 只常驻27B；ASR已迁移到.2 CPU。该阈值继续作为27B路由安全余量。
GTA_AI_ADMISSION_MINIMUM_FREE_MB=1536
# 27B 已配置 max-num-seqs=2，允许两个历史翻译请求并行进入模型。
GTA_AI_ADMISSION_MAX_ACTIVE=2
