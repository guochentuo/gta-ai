[Unit]
Description=GTA SigLIP2 CPU Image Embedding Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gta-ai/siglip
Environment="GTA_AI_CONFIG_FILES=/opt/gta-ai/siglip/config/vision.env,/opt/gta-ai/siglip/config/node.env"
# 部署注入的日志标识（GTA_ENV/GTA_NODE/GTA_DEPLOY_SHA/LOG_LEVEL），文件不存在时忽略。
EnvironmentFile=-/opt/gta-ai/siglip/deploy.env
ExecStartPre=-/usr/bin/podman rm --force gta-ai-image-embedding
ExecStart=/opt/gta-ai/siglip/deploy/run-vision.sh
ExecStop=-/usr/bin/podman stop --time 30 gta-ai-image-embedding
Restart=on-failure
RestartSec=15
TimeoutStartSec=1800
TimeoutStopSec=60
CPUQuota=2400%
CPUWeight=20
MemoryHigh=14G
MemoryMax=18G
MemorySwapMax=0
IOWeight=20
Nice=10
OOMScoreAdjust=500
TasksMax=2048
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gta-ai-image-embedding

[Install]
WantedBy=multi-user.target
