GTA_AI_APP_ENV=development
GTA_AI_HOST=127.0.0.1
GTA_AI_PORT=8080
GTA_AI_LOG_LEVEL=INFO

# Local vLLM OpenAI-compatible endpoint. A real API key is normally unnecessary
# for a loopback-only vLLM deployment.
GTA_AI_LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
GTA_AI_LOCAL_LLM_MODEL=Qwen/Qwen3.6-27B-FP8
GTA_AI_LOCAL_LLM_API_KEY=
GTA_AI_LOCAL_LLM_TIMEOUT_SECONDS=600
GTA_AI_LOCAL_LLM_HEALTH_TIMEOUT_SECONDS=3

# External final-decision model. Leave the key empty until integration testing.
GTA_AI_OPENAI_API_KEY=
GTA_AI_OPENAI_MODEL=gpt-5.6-sol
GTA_AI_OPENAI_REASONING_EFFORT=high
GTA_AI_OPENAI_TIMEOUT_SECONDS=300

# 素材审核。gta-ai 只读取素材投影、写审核 ES，并通过 HMAC 回调 Java；没有数据库配置。
GTA_AI_MEDIA_AUDIT_ENABLED=false
GTA_AI_MEDIA_AUDIT_API_TOKEN=
GTA_AI_MEDIA_AUDIT_ELASTICSEARCH_URL=https://192.168.80.2:9200
GTA_AI_MEDIA_AUDIT_ELASTICSEARCH_USERNAME=elastic
GTA_AI_MEDIA_AUDIT_ELASTICSEARCH_PASSWORD=
GTA_AI_MEDIA_AUDIT_ELASTICSEARCH_VERIFY_TLS=false
GTA_AI_MEDIA_AUDIT_MATERIAL_ALIAS=gta_media_admin
GTA_AI_MEDIA_AUDIT_RESULT_ALIAS=gta_media_content_audit
GTA_AI_MEDIA_AUDIT_JAVA_CALLBACK_URL=http://127.0.0.1:9201/internal/material-ai-audits/completed
GTA_AI_MEDIA_AUDIT_JAVA_CALLBACK_SECRET=
GTA_AI_MEDIA_AUDIT_MAX_CONCURRENCY=1
GTA_AI_MEDIA_AUDIT_PROJECTION_RETRY_SECONDS=5
GTA_AI_MEDIA_AUDIT_TRANSIENT_RETRY_MAX_ATTEMPTS=0
GTA_AI_MEDIA_AUDIT_MAX_OUTPUT_TOKENS=2200
GTA_AI_MEDIA_AUDIT_IMAGE_MAX_OUTPUT_TOKENS=700
GTA_AI_MEDIA_AUDIT_LOG_PATH=/opt/gta-ai/logs/gta.ai.audit.log
GTA_AI_MEDIA_AUDIT_KAFKA_BOOTSTRAP_SERVERS=192.168.80.4:11092,192.168.80.5:11092,192.168.80.6:11092
GTA_AI_MEDIA_AUDIT_KAFKA_REQUEST_TOPIC=gta.media.audit.request.v1
GTA_AI_MEDIA_AUDIT_KAFKA_CANCEL_TOPIC=gta.media.audit.cancel.v1
GTA_AI_MEDIA_AUDIT_KAFKA_RESULT_TOPIC=gta.media.audit.result.v1
GTA_AI_MEDIA_AUDIT_KAFKA_GROUP_ID=gta-ai-media-audit-v1

# 素材查询。Java 只调用该接口，不持有 ES 地址、凭据、索引名或客户端依赖。
GTA_AI_MATERIAL_SEARCH_ENABLED=true
GTA_AI_MATERIAL_SEARCH_TIMEOUT_SECONDS=15
GTA_AI_MATERIAL_SEARCH_EMBEDDING_ENABLED=true
GTA_AI_MATERIAL_SEARCH_EMBEDDING_URL=http://192.168.80.2:18080/v1/embeddings
GTA_AI_MATERIAL_SEARCH_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
GTA_AI_MATERIAL_SEARCH_DIMENSIONS=1024
