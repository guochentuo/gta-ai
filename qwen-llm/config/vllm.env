# gta-ai local inference profile. This file contains no secrets.
VLLM_IMAGE=docker.io/vllm/vllm-openai@sha256:7a0f0fdd2771464b6976625c2b2d5dd46f566aa00fbc53eceab86ef50883da90
VLLM_MODEL_PATH=/opt/gta-ai/27b/models/Qwen3.8-27B-FP8
VLLM_SERVED_MODEL_NAME=Qwen/Qwen3.8-27B-FP8
VLLM_BASE_SERVED_MODEL_NAME=Qwen/Qwen3.8-27B-FP8-base
VLLM_HOST=127.0.0.1
VLLM_PORT=7106
VLLM_MAX_MODEL_LEN=8192
# 最多同时调度五个推理序列；单请求时仍可独占GPU计算能力。
VLLM_MAX_NUM_SEQS=5
VLLM_KV_CACHE_DTYPE=fp8
# 为五路并发预留更大的KV Cache；保留约10%显存作为运行安全余量。
VLLM_GPU_MEMORY_UTILIZATION=0.90
# 复用固定身份提示及多轮会话的共同前缀。
VLLM_ENABLE_PREFIX_CACHING=true
# 限制单轮Prefill批次规模，使Decode和短请求更快获得调度机会。
VLLM_MAX_NUM_BATCHED_TOKENS=2048
VLLM_ENABLE_CHUNKED_PREFILL=true
# Router会按上下文长度写入priority，较短请求优先。
VLLM_SCHEDULING_POLICY=priority
VLLM_SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
VLLM_ACTIVE_ADAPTER_PATH=/opt/gta-ai/27b/training/adapters/active
VLLM_MAX_LORA_RANK=16

# 27B日志：控制台只显示启停和错误，完整运行记录写文件并发送Kafka。
GTA_AI_LOG_DIR=/opt/gta-ai/qwen-llm/logs
GTA_AI_LOG_MAX_MB=20
GTA_AI_LOG_BACKUPS=10
GTA_AI_LOG_KAFKA_ENABLED=true
GTA_AI_LOG_KAFKA_BROKERS=192.168.80.4:11092,192.168.80.5:11092,192.168.80.6:11092
GTA_AI_LOG_KAFKA_TOPIC=gta.video.worker.logs
