GTA_AI_TRAINER_ROUTER_STATE_PATH=/opt/gta-ai/qwen-llm/state/router-state.json
GTA_AI_TRAINER_PENDING_MANIFEST_PATH=/opt/gta-ai/qwen-llm/data/training/queue/pending.json
GTA_AI_TRAINER_DEPLOYED_MANIFEST_PATH=/opt/gta-ai/qwen-llm/data/training/runtime/deployed.json
GTA_AI_TRAINER_CANDIDATE_MANIFEST_PATH=/opt/gta-ai/qwen-llm/data/training/runtime/candidate.json
GTA_AI_TRAINER_ACTIVE_ADAPTER_PATH=/opt/gta-ai/qwen-llm/data/training/adapters/active
GTA_AI_TRAINER_STATUS_PATH=/opt/gta-ai/qwen-llm/data/training/runtime/trainer-state.json
GTA_AI_TRAINER_GPU_LOCK_PATH=/opt/gta-ai/qwen-llm/state/gpu.lock
GTA_AI_TRAINER_COMMAND=/opt/gta-ai/qwen-llm/deploy/training/run-identity-training.sh
GTA_AI_TRAINER_INFERENCE_SERVICE=gta-ai-vllm.service
# 一次请求结束后持续空闲 15 分钟，才允许占用 GPU。
GTA_AI_TRAINER_IDLE_SECONDS=900
GTA_AI_TRAINER_POLL_SECONDS=0.25
GTA_AI_TRAINER_TERMINATE_GRACE_SECONDS=3
# 真失败后同一版本至少退避一小时; 新训练版本不受旧版本退避影响。
GTA_AI_TRAINER_FAILURE_BACKOFF_SECONDS=3600
GTA_AI_TRAINER_CONTAINER_NAME=gta-ai-identity-trainer
GTA_AI_TRAINER_VALIDATOR_CONTAINER_NAME=gta-ai-identity-validator
