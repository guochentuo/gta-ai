# Router使用7100；vLLM后端7106只供本机Router访问。
GTA_AI_ROUTER_HOST=192.168.80.7
GTA_AI_ROUTER_PORT=7100
GTA_AI_ROUTER_BACKEND_URL=http://127.0.0.1:7106
# 对外可使用自定义模型名，Router转发给vLLM时统一替换为该真实模型名称。
GTA_AI_ROUTER_INTERNAL_MODEL=Qwen/Qwen3.8-27B-FP8
GTA_AI_ROUTER_STATE_PATH=/opt/gta-ai/qwen-llm/state/router-state.json
GTA_AI_ROUTER_GPU_LOCK_PATH=/opt/gta-ai/qwen-llm/state/gpu.lock
GTA_AI_ROUTER_WAKE_TIMEOUT_SECONDS=300
GTA_AI_ROUTER_BACKEND_POLL_SECONDS=0.25
GTA_AI_ROUTER_REQUEST_TIMEOUT_SECONDS=1800
# 普通模式关闭思考时，统一保证至少可生成2048个Token。
GTA_AI_ROUTER_STANDARD_MAX_TOKENS=2048
# Adapter通过验收前保持身份提示；候选上线后改为false验证无提示词身份。
GTA_AI_PERSONA_PROMPT_ENABLED=true
# 只保留最近三轮对话，并限制历史正文长度，避免多轮会话持续拖慢Prefill。
GTA_AI_ROUTER_MAX_HISTORY_MESSAGES=6
GTA_AI_ROUTER_MAX_HISTORY_CHARS=2000
GTA_AI_ROUTER_MAX_CONCURRENT_WORKLOADS=5
GTA_AI_ADMISSION_DB_PATH=/opt/gta-ai/qwen-llm/state/gpu-admission.sqlite3
GTA_AI_ADMISSION_POLL_SECONDS=0.1
# .7 只常驻27B；ASR已迁移到.2 CPU。该阈值继续作为27B路由安全余量。
GTA_AI_ADMISSION_MINIMUM_FREE_MB=1536
# 与vLLM的max-num-seqs保持一致，最多允许五个推理请求同时进入模型调度。
GTA_AI_ADMISSION_MAX_ACTIVE=5
# 模型首次加载成功后执行一次短测速；不会周期性重复生成测试内容。
GTA_AI_ROUTER_STARTUP_BENCHMARK_ENABLED=true
GTA_AI_ROUTER_STARTUP_BENCHMARK_MAX_TOKENS=32

# 业务知识检索：问题先由0.6B生成1024维向量，再查询业务ES并注入27B上下文。
GTA_AI_RETRIEVAL_ENABLED=true
GTA_AI_RETRIEVAL_EMBEDDING_URL=http://192.168.80.7:7101/v1/embeddings
GTA_AI_RETRIEVAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
GTA_AI_RETRIEVAL_ELASTICSEARCH_URL=https://192.168.80.130:9200
GTA_AI_RETRIEVAL_ELASTICSEARCH_USERNAME=elastic
GTA_AI_RETRIEVAL_ELASTICSEARCH_PASSWORD=kp-+K3SgKFJs_+UDojK9
GTA_AI_RETRIEVAL_ELASTICSEARCH_INDICES=gta_article_admin,gta_trip_admin,gta_video_admin,gta_province_admin,gta_city_admin,gta_scenic_admin
# 当前ES使用内网自签名证书。
GTA_AI_RETRIEVAL_VERIFY_TLS=false
# 检索异常时快速降级为普通对话，不阻塞模型回复。
GTA_AI_RETRIEVAL_TIMEOUT_SECONDS=1.5
GTA_AI_RETRIEVAL_TOP_K=12
# ES多取候选用于筛选三张相关图片，但只把最相关3条文本交给27B，降低首字延迟。
GTA_AI_RETRIEVAL_CONTEXT_TOP_K=3
GTA_AI_RETRIEVAL_NUM_CANDIDATES=100
GTA_AI_RETRIEVAL_MAX_QUERY_CHARS=1000
GTA_AI_RETRIEVAL_MAX_CONTEXT_CHARS=1200
GTA_AI_RETRIEVAL_MAX_DOCUMENT_CHARS=350
# 低于该语义相关度时视为无有效知识，不向27B注入资料，也不返回图片。
GTA_AI_RETRIEVAL_MIN_SCORE=0.72
# 图片必须同时通过更严格的独立阈值和目的地主题匹配，避免把相似文章封面当作相关图片。
GTA_AI_RETRIEVAL_IMAGE_MIN_SCORE=0.78

# 广告首屏欢迎模板：使用0.6B生成关键词向量，并从AI自有索引召回已发布模板。
GTA_AI_WELCOME_TEMPLATE_ENABLED=true
GTA_AI_WELCOME_TEMPLATE_INDEX=gta_ai_welcome_template_v1
GTA_AI_WELCOME_TEMPLATE_TIMEOUT_SECONDS=2.0
# 欢迎正文按字符流式输出；12毫秒约为每秒80个字符。
GTA_AI_WELCOME_TEMPLATE_CHARACTER_INTERVAL_MS=12

# 欢迎模板多语言：ES只保存中文母版；本机27B通过vLLM内部端口本地化，结果缓存到Redis。
GTA_AI_WELCOME_LOCALIZATION_ENABLED=true
GTA_AI_WELCOME_LOCALIZATION_URL=http://127.0.0.1:18086/v1/chat/completions
GTA_AI_WELCOME_LOCALIZATION_MODEL=Qwen/Qwen3.8-27B-FP8
GTA_AI_WELCOME_LOCALIZATION_TIMEOUT_SECONDS=120
GTA_AI_WELCOME_LOCALIZATION_MAX_TOKENS=4096
GTA_AI_WELCOME_LOCALIZATION_CACHE_KEY_PREFIX=gta:ai:welcome-localized
# 本地化缓存保留30天；中文母版version变化时会自动使用新缓存键。
GTA_AI_WELCOME_LOCALIZATION_CACHE_TTL_SECONDS=2592000
# Router启动后后台顺序预热主要客源语言，不阻塞端口启动。
GTA_AI_WELCOME_LOCALIZATION_PREWARM_LOCALES=en-US,zh-TW,ja-JP,ko-KR,de-DE,fr-FR,es-ES,th-TH
GTA_AI_WELCOME_LOCALIZATION_PREWARM_KEYWORD=中国旅行

# 行程精确核价：ES只负责匹配线路，日期价、人数、库存、黑名单和共享费用以该接口为准。
GTA_AI_QUOTE_URL=http://192.168.100.5:8087/spuFeign/quoteSpu
# 核价失败必须快速降级，不能阻塞27B正常回复。
GTA_AI_QUOTE_TIMEOUT_SECONDS=1.5

# CPU会话摘要：只通过本机7107调用，不暴露给外部。
GTA_AI_SUMMARIZATION_ENABLED=true
GTA_AI_SUMMARIZATION_URL=http://127.0.0.1:7107/v1/chat/completions
GTA_AI_SUMMARIZATION_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M
GTA_AI_SUMMARIZATION_TIMEOUT_SECONDS=120
GTA_AI_SUMMARIZATION_MAX_SUMMARY_CHARS=800
# 每次交给27B的会话记忆不超过1200个估算Token；超限时优先保留长期摘要、相关内容和最近两轮。
GTA_AI_SUMMARIZATION_MAX_CONTEXT_TOKENS=1200
GTA_AI_SUMMARIZATION_RECENT_TURNS=2
# 正式会话记忆直接使用Redis集群，不依赖Java项目或Nacos配置。
GTA_AI_REDIS_KEY_PREFIX=gta:ai:session
# 会话摘要和未压缩最近消息保留30天。
GTA_AI_REDIS_TTL_SECONDS=2592000
GTA_AI_REDIS_SOCKET_TIMEOUT_SECONDS=2
GTA_AI_REDIS_CLUSTER_NODES=192.168.80.4:7001,192.168.80.5:7001,192.168.80.6:7001
GTA_AI_REDIS_PASSWORD=gta@Dev123

# CPU 4B只负责后台会话摘要；所有前台问答统一使用27B。
GTA_AI_SIMPLE_CHAT_ENABLED=false
GTA_AI_SIMPLE_CHAT_URL=http://127.0.0.1:7107
GTA_AI_SIMPLE_CHAT_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M
GTA_AI_SIMPLE_CHAT_MAX_TOKENS=192

# 27B日志：控制台只显示启停和错误，完整运行记录写文件并发送Kafka。
GTA_AI_LOG_DIR=/opt/gta-ai/qwen-llm/logs
GTA_AI_LOG_MAX_MB=20
GTA_AI_LOG_BACKUPS=10
GTA_AI_LOG_KAFKA_ENABLED=true
GTA_AI_LOG_KAFKA_BROKERS=192.168.80.4:11092,192.168.80.5:11092,192.168.80.6:11092
GTA_AI_LOG_KAFKA_TOPIC=gta.video.worker.logs
