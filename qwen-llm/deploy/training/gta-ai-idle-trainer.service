[Unit]
Description=gta-ai preemptible idle LoRA trainer
Wants=network-online.target gta-ai-router.service
After=network-online.target gta-ai-router.service

[Service]
Type=simple
UMask=0002
WorkingDirectory=/opt/gta-ai/qwen-llm
EnvironmentFile=/opt/gta-ai/qwen-llm/config/training/trainer.env
ExecStart=/opt/gta-ai/qwen-llm/.venv/bin/python /opt/gta-ai/qwen-llm/training/idle_trainer.py
Restart=always
RestartSec=2
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gta-ai-idle-trainer

[Install]
WantedBy=default.target
